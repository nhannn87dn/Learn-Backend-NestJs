
# .env.production
NODE_ENV=production
PORT=3000
APP_PORT=3000

# Database (Sử dụng giá trị mạnh hơn)
POSTGRES_USER=nestjs_prod_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE_CHANGE_ME
POSTGRES_DB=nestjs_production
DATABASE_URL=postgresql://nestjs_prod_user:STRONG_PASSWORD_HERE_CHANGE_ME@postgres:5432/nestjs_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_STRONG_PASSWORD_CHANGE_ME

# JWT
JWT_SECRET=super-secret-jwt-key-min-32-characters-change-me

# API Keys
API_KEY=your-api-key-here