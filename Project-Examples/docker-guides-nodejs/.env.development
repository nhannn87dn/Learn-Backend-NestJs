# .env.development
NODE_ENV=development
PORT=3000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs_dev
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nestjs_dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=dev-secret-key-change-in-production

