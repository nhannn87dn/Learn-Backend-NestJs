# docker/Dockerfile.dev
FROM node:20-alpine

# Cài đặt các dependencies cần thiết
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package files
COPY package*.json ./

# Cài đặt dependencies (bao gồm cả devDependencies)
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server với hot reload
CMD ["npm", "run", "start:dev"]